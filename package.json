{
  "name": "visualized-code",
  "displayName": "Code Execution Visualizer",
  "description": "Visualize function calls, classes, and live execution across JavaScript, TypeScript, React, Next.js, and Python projects.",
  "version": "0.0.5",
  "icon": "media/icon.png",
  "publisher": "lockitech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eliyas-Wubie/visualize_code.git"
  },
  "homepage": "https://github.com/Eliyas-Wubie/visualize_code#readme",
  "bugs": {
    "url": "https://github.com/Eliyas-Wubie/visualize_code/issues"
  },
  "files": [
    "src/**/*.js",
    "runtime/**/*.cjs",
    "runtime/**/*.mjs",
    "runtime/python/*.py",
    "media/bundle.js",
    "media/bundle.css",
    "media/activity.svg",
    "media/icon.png",
    "media/THIRD_PARTY_NOTICES.txt",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:visualizeCode.apps"
  ],
  "scripts": {
    "vscode:prepublish": "npm run build && npm run check:package",
    "build": "node scripts/build.js",
    "check": "npm run check:syntax && npm run check:python",
    "check:syntax": "node scripts/check.js",
    "check:python": "python -B scripts/check_python.py",
    "check:package": "node scripts/verify-package.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "test:ci": "node scripts/run-ci-tests.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "visualizeCode",
          "title": "Visualize Code",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "visualizeCode": [
        {
          "id": "visualizeCode.apps",
          "name": "Applications"
        }
      ]
    },
    "commands": [
      {
        "command": "visualizeCode.refreshApps",
        "title": "Visualize Code: Refresh Applications",
        "icon": "$(refresh)"
      },
      {
        "command": "visualizeCode.scanApp",
        "title": "Visualize Code: Scan Application"
      },
      {
        "command": "visualizeCode.scanFile",
        "title": "Visualize Code: Visualize Listed File"
      },
      {
        "command": "visualizeCode.runLive",
        "title": "Visualize Code: Run Active File Live"
      },
      {
        "command": "visualizeCode.fromCursor",
        "title": "Visualize Code: Trace from Cursor"
      },
      {
        "command": "visualizeCode.pickStart",
        "title": "Visualize Code: Choose Starting Function"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "visualizeCode.refreshApps",
          "when": "view == visualizeCode.apps",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "visualizeCode.fromCursor",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    }
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
